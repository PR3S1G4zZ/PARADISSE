PORT=3001
# Explicit origin only. CORS_ORIGIN=* is rejected when NODE_ENV=production.
CORS_ORIGIN=http://localhost:5173
# Required for /api/auth/*. Health and map/routing still work without it.
DATABASE_URL=postgres://paradisse:paradisse@localhost:5432/paradisse
# Session cookie (paradisse_session) is HttpOnly + SameSite=Lax.
# Secure is enabled automatically when NODE_ENV=production.
# SESSION_TTL_MS=604800000
ARCGIS_BASEMAP_API_KEY=
ARCGIS_API_KEY=
ARCGIS_CLIENT_ID=
ARCGIS_CLIENT_SECRET=
ARCGIS_REFERER=
ROUTING_HTTP_TIMEOUT_MS=8000
